# Copy to .env.local and fill in the token. .env.local is gitignored.
# Site: bank.com
NEXT_PUBLIC_DOTCMS_HOST=http://localhost:8082

# Generate in dotCMS: System > Users > admin > API Access Tokens.
# Use a READ-ONLY token scoped to Pages, Folders, Assets and Content.
NEXT_PUBLIC_DOTCMS_AUTH_TOKEN=

NEXT_PUBLIC_DOTCMS_SITE_ID=4afebb3f5a60baed95fa8e55e1038087
NEXT_PUBLIC_DOTCMS_MODE=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Bank name used in JSON-LD structured data (defaults to World Demo Bank).
# NEXT_PUBLIC_SITE_NAME=World Demo Bank

# Content type the blog listing queries. `Blog` on local bank.com (the default);
# set to BankBlog for worlddemobank.com on awesomedemo-dev.
# NEXT_PUBLIC_DOTCMS_BLOG_TYPE=Blog
